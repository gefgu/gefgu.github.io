---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
const year = new Date().getFullYear();
---

<footer class="animate">
  <Container>
    © {year} {SITE.NAME}
    {SOCIALS.map((s) => (<> · <a href={s.HREF}>{s.NAME}</a></>))}
    · <a href={`mailto:${SITE.EMAIL}`}>mail</a>
  </Container>
</footer>
