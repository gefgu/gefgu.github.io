---
const destination = "https://gustavohsantos.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Redirecting…</title>
    <script>
      window.location.replace("https://gustavohsantos.com/");
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={destination}>gustavohsantos.com</a>…</p>
  </body>
</html>
